          { "left": { "en": "Inama", "rw": "Inama" }, "right": { "en": "Meeting", "rw": "Inama" } }
        ]},
        { "type": "mcq", "question": { "en": "How do you say 'Good work'?", "rw": "Ni gute wabwira umuntu uti 'Akazi keza'?" }, "options": [{ "en": "Akazi keza", "rw": "Akazi keza" }, { "en": "Urakoze", "rw": "Urakoze" }, { "en": "Muraho", "rw": "Muraho" }, { "en": "Hobe", "rw": "Hobe" }], "correctIndex": 0 },
        { "type": "tf", "question": { "en": "In Rwanda, it's common to address bosses as 'Bwana' or 'Madamu'.", "rw": "Mu Rwanda, birasanzwe kwita abayobozi 'Bwana' cyangwa 'Madamu'." }, "correctAnswer": true }
      ]
    }
  ],
