    {
      "id": "topic-1",
      "title": {
        "en": "Greetings and Introductions",
        "rw": "Indamukanyo n'Ukwivuga"
      },
      "notes": {
        "en": "In a professional setting in Rwanda, greetings are very important. Always start with a polite greeting. 'Muraho' is a general greeting. 'Mwaramutse' is used in the morning, and 'Mwiriwe' is used in the afternoon/evening.",
        "rw": "Mu rwego rw'akazi mu Rwanda, indamukanyo ni ingenzi cyane. Buri gihe tangira usuhuza neza. 'Muraho' niyo ndamukanyo rusange. 'Mwaramutse' ikoreshwa mu gitondo, naho 'Mwiriwe' ikoreshwa nyuma ya saa sita cyangwa nimugoroba."
      },
      "assessment": [
        { "type": "mcq", "question": { "en": "Which greeting is appropriate for use in the morning?", "rw": "Ni iyihe ndamukanyo ikwiye gukoreshwa mu gitondo?" }, "options": [{ "en": "Mwiriwe", "rw": "Mwiriwe" }, { "en": "Mwaramutse", "rw": "Mwaramutse" }, { "en": "Muraho", "rw": "Muraho" }, { "en": "Bwakeye", "rw": "Bwakeye" }], "correctIndex": 1 },
        { "type": "tf", "question": { "en": "'Muraho' can be used at any time of day.", "rw": "'Muraho' ishobora gukoreshwa igihe icyo ari cyo cyose cy'umunsi." }, "correctAnswer": true },
        { "type": "mcq", "question": { "en": "How do you say 'Thank you very much' in Kinyarwanda?", "rw": "Ni gute wavuga 'Urakoze cyane' mu Kinyarwanda?" }, "options": [{ "en": "Murakoze cyane", "rw": "Murakoze cyane" }, { "en": "Ndashaka kwiga", "rw": "Ndashaka kwiga" }, { "en": "Amakuru ni meza", "rw": "Amakuru ni meza" }, { "en": "Ni byiza", "rw": "Ni byiza" }], "correctIndex": 0 },
        { "type": "matching", "question": { "en": "Match the greeting to the time:", "rw": "Huza indamukanyo n'igihe gikwiye:" }, "pairs": [
          { "left": { "en": "Mwaramutse", "rw": "Mwaramutse" }, "right": { "en": "Morning", "rw": "Igitondo" } },
          { "left": { "en": "Mwiriwe", "rw": "Mwiriwe" }, "right": { "en": "Afternoon", "rw": "Nyuma ya saa sita" } },
          { "left": { "en": "Muramuke", "rw": "Muramuke" }, "right": { "en": "Good night", "rw": "Ijoro ryiza" } }
        ]},
        { "type": "mcq", "question": { "en": "What is the standard response to 'Amakuru?'", "rw": "Igisubizo gisanzwe ku 'Amakuru?' ni ikihe?" }, "options": [{ "en": "Meza", "rw": "Meza" }, { "en": "Ni meza", "rw": "Ni meza" }, { "en": "Muraho", "rw": "Muraho" }, { "en": "Yego", "rw": "Yego" }], "correctIndex": 1 },
        { "type": "tf", "question": { "en": "'Amakuru' literally means 'The news'.", "rw": "'Amakuru' bisobanura amakuru (news)." }, "correctAnswer": true }
      ]
    },
    {
      "id": "topic-2",
      "title": {
        "en": "Workplace Communication",
        "rw": "Itumanaho mu Kazi"
      },
      "notes": {
        "en": "Effective workplace communication involves using professional language. When asking for something, use 'Ndashaka...' or more politely 'Nagombaga...'. When finishing a task, say 'Naranyuzwe' or 'Birarangiye'. Polite requests often include 'Nyamuneka'.",
        "rw": "Itumanaho ryiza mu kazi rishingiye ku gukoresha ururimi rwa kinyamwuga. Iyo ushaka ikintu, koresha 'Ndashaka...' cyangwa mu buryo bw'ikinyabupfura 'Nagombaga...'. Iyo urangije umurimo, vuga 'Naranyuzwe' cyangwa 'Birarangiye'. Iyo usaba ikintu neza ukoresha 'Nyamuneka'."
      },
      "assessment": [
        { "type": "mcq", "question": { "en": "How do you politely say 'Please'?", "rw": "Ni gute wavuga 'Nyamuneka' mu buryo bw'ikinyabupfura?" }, "options": [{ "en": "Nyamuneka", "rw": "Nyamuneka" }, { "en": "Bikore", "rw": "Bikore" }, { "en": "Vuba", "rw": "Vuba" }, { "en": "Urakoze", "rw": "Urakoze" }], "correctIndex": 0 },
        { "type": "tf", "question": { "en": "'Birarangiye' means 'It is finished'.", "rw": "'Birarangiye' bisobanura ko umurimo urangiye." }, "correctAnswer": true },
        { "type": "mcq", "question": { "en": "What is the word for 'Office'?", "rw": "Ijambo risobanura 'Ibiro' (office) ni irihe?" }, "options": [{ "en": "Ibiro", "rw": "Ibiro" }, { "en": "Ishuri", "rw": "Ishuri" }, { "en": "Isoko", "rw": "Isoko" }, { "en": "Uruganda", "rw": "Uruganda" }], "correctIndex": 0 },
        { "type": "matching", "question": { "en": "Match professional terms:", "rw": "Huza amagambo ya kinyamwuga:" }, "pairs": [
